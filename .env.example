# SQLite database path (default relative sqlite file)
DATABASE_URL="file:./dev.db"

# JWT Signing Secret (used to encode auth cookie payloads)
JWT_SECRET="change-this-to-a-highly-secure-random-hash-for-production-deploys"

# Stripe Test Mode API Keys (Leave blank to run in simulated mockup mode!)
STRIPE_SECRET_KEY="sk_test_yourSecretKeyHere"
STRIPE_PUBLISHABLE_KEY="pk_test_yourPublishableKeyHere"

# Stripe Webhook Secret (used to verify stripe-signature headers)
STRIPE_WEBHOOK_SECRET="whsec_yourWebhookSecretHere"
